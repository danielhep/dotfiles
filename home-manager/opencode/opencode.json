{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "question": "allow"
  },
  "plugin": [
    "oh-my-opencode-slim",
    "@guard22/opencode-multi-auth-codex@latest"
  ],
  "provider": {
    "tower": {
      "npm": "@ai-sdk/openai",
      "name": "Tower Proxy",
      "options": {
        "baseURL": "http://tower:8095/v1",
        "apiKey": "pwd"
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
